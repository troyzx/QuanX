#!name=彩云天气净化
#!desc=彩云天气广告/活动推广净化（Shadowrocket）。基于 @ddgksf2013 墨鱼版 V1.0.8 的去广告逻辑适配；不包含会员/VIP权限修改。
#!author=ddgksf2013; Shadowrocket adaptation for troyzx
#!homepage=https://github.com/troyzx/QuanX

[URL Rewrite]
# 通用广告请求
^https?://ad\.cyapi\.cn/v\d+ _ reject-200

[Script]
CaiYunAds = type=http-response,pattern=^https?://(wrapper\.cyapi\.cn/v\d/activity|api\.caiyunapp\.com/v\d/activity|starplucker\.cyapi\.cn/v\d/(operation/(homefeatures|feeds|banners|features)|campaigns|notification/message_center|config/cypage)),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/troyzx/QuanX/master/Shadowrocket/Scripts/caiyun_ads.js
CaiYunVip = type=http-response,pattern=^https?://biz\.cyapi\.cn/(api/v\d/user_detail|v\d/user),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/troyzx/QuanX/master/Shadowrocket/Scripts/caiyun_ads.js


[MITM]
hostname = %APPEND% wrapper.cyapi.cn, api.caiyunapp.com, starplucker.cyapi.cn, ad.cyapi.cn, biz.cyapi.cn
